# Copie para .env se quiser mudar algo. O docker-compose funciona sem isso —
# todos os valores abaixo já são os padrões.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=chave-insegura-apenas-para-dev
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# Banco
POSTGRES_DB=seguradoras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Portas expostas na máquina
PORTA_API=8000
POSTGRES_PORT_EXTERNA=5433

# Cache (segundos)
CACHE_LISTAGEM_TTL=60

# Integração externa
BRASILAPI_CNPJ_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}
BRASILAPI_TIMEOUT=5
